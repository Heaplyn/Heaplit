<!-- Summary: Main visual dashboard layout containing search bar inputs, divider separator, and fuzzy-sorted suggestions ListBox. -->
<Window x:Class="HeaplitLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        xmlns:local="clr-namespace:HeaplitLauncher"
        mc:Ignorable="d"
        Title="Heaplit Launcher" 
        Width="680"
        SizeToContent="Height"
        MaxHeight="550"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        ResizeMode="NoResize" 
        ShowInTaskbar="True"
        Topmost="True"
        Loaded="Window_Loaded">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Animations.xaml"/>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="10">
        <!-- Shadow Container -->
        <Border x:Name="MainBorder" 
                Background="{DynamicResource WindowBackgroundBrush}" 
                BorderBrush="{DynamicResource WindowBorderBrush}" 
                BorderThickness="1" 
                CornerRadius="{DynamicResource WindowCornerRadius}" 
                Opacity="1.0"
                ClipToBounds="True">

            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.1" ShadowDepth="4"/>
            </Border.Effect>

            <Border.RenderTransform>
                <TranslateTransform x:Name="WindowTranslate" Y="-50"/>
            </Border.RenderTransform>

            <Grid>
                <!-- GIF/Media Background -->
                <Image x:Name="BackgroundMedia"
                       gif:ImageBehavior.AnimatedSource="{DynamicResource WindowBackgroundMediaSource}"
                       gif:ImageBehavior.RepeatBehavior="Forever"
                       Stretch="UniformToFill"
                       Opacity="0.6"
                       IsHitTestVisible="False"
                       Visibility="{DynamicResource WindowMediaVisibility}"/>

                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search Panel -->
                    <Grid Grid.Row="0">
                        <TextBox x:Name="SearchInput"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 FontSize="20"
                                 FontFamily="{DynamicResource ActiveFontFamily}"
                                 CaretBrush="{DynamicResource AccentCaretBrush}"
                                 Padding="6,4"
                                 VerticalAlignment="Center"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="Wrap"
                                 MaxHeight="120"
                                 VerticalScrollBarVisibility="Auto"
                                 TextChanged="SearchInput_TextChanged"
                                 PreviewKeyDown="SearchInput_PreviewKeyDown"/>

                        <local:OutlinedText x:Name="PlaceholderText"
                                   Text="Type a command, math, or app name..."
                                   Category="Search"
                                   Foreground="{DynamicResource TextPlaceholderBrush}"
                                   FontSize="20"
                                   FontFamily="{DynamicResource ActiveFontFamily}"
                                   IsHitTestVisible="False"
                                   Margin="12,4"
                                   VerticalAlignment="Top"/>

                        <!-- Autocomplete ghost suffix (Tab to accept) -->
                        <local:OutlinedText x:Name="AutocompleteGhost"
                                   Category="Search"
                                   Foreground="{DynamicResource TextPlaceholderBrush}"
                                   FontSize="20"
                                   FontFamily="{DynamicResource ActiveFontFamily}"
                                   IsHitTestVisible="False"
                                   Margin="6,4"
                                   Padding="6,4"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Visibility="Collapsed"
                                   Opacity="0.45"/>
                    </Grid>

                    <!-- Divider line -->
                    <Separator Grid.Row="1"
                               Background="#26FFFFFF"
                               Margin="0,8,0,8"
                               Height="1"
                               x:Name="DividerLine"
                               Visibility="Collapsed"/>

                    <!-- Suggestions Panel -->
                    <ListBox Grid.Row="2"
                             x:Name="ResultsList"
                             Background="Transparent" 
                             BorderThickness="0" 
                             ItemContainerStyle="{StaticResource ResultItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Item"
                             SelectionMode="Single"
                             Visibility="Collapsed"
                             MouseDoubleClick="ResultsList_MouseDoubleClick"
                             PreviewMouseLeftButtonUp="ResultsList_PreviewMouseLeftButtonUp"
                             PreviewKeyDown="ResultsList_PreviewKeyDown">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical">
                                    <local:OutlinedText Text="{Binding TITLE}"
                                               Category="Cards"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               FontFamily="{DynamicResource ActiveFontFamily}"/>
                                    <local:OutlinedText Text="{Binding DESCRIPTION}"
                                               Category="Subtext"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="12"
                                               Margin="0,2,0,0"
                                               FontFamily="{DynamicResource ActiveFontFamily}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
